<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Compose가 실제 테마/색을 그리지만, Activity 시작 시 잠깐 보이는 스플래시 배경과
        시스템 윈도우(상단 상태바) 색을 위해 최소 한 개의 AppCompat 호환 테마가 필요하다.
        Compose 자체에는 영향을 주지 않는다.
    -->
    <style name="Theme.HaruBook" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/smap_background</item>
        <item name="android:statusBarColor">@color/smap_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!--
        Android 12+ SplashScreen API 패리티 — iOS UILaunchScreen(UIColorName=LaunchBackground)
        와 동일하게 단순 배경색(#FBFAF9)만 보여주고 앱 아이콘은 표시하지 않는다.
        시스템이 강제로 런처 아이콘을 띄우지 않도록 windowSplashScreenAnimatedIcon 을
        투명 drawable 로 지정. postSplashScreenTheme 로 본 테마(Theme.HaruBook)로 전환된다.
    -->
    <style name="Theme.HaruBook.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/smap_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.HaruBook</item>
    </style>
</resources>
