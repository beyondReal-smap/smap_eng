<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 광고/추적 SDK 미사용. 외부 도메인을 통한 트래킹 없음. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
        App Store Connect의 "앱 개인정보보호 정보(Privacy Nutrition Label)"와 일치하도록
        실제 수집 항목을 선언한다.

        - 이메일: 가입/로그인. Linked to user. 분석/광고 미사용.
        - 사용자 콘텐츠(아이가 만든 책·독서/퀴즈 기록): 서비스 제공·기능 동작에만 사용.
        - 결제 정보는 외부(토스/IAP) 처리 — 앱이 직접 수집하지 않음.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!--
        Required Reason APIs — Apple 2024년 정책. 사용하는 API의 사용 사유를 명시.

        UserDefaults: 세션 프리퍼런스(lastProfileId), SRS 학습 진도, 보호자 PIN 잠금 시간 등
                      앱 자신의 상태 보관에만 사용.
        File timestamp: TTS 캐시 파일(`passage-{id}.wav`) 존재/수정 시간 확인.
                       데이터 전송 없음.
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1 — Access info from the same app, per documentation. -->
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- 3B52.1 — Inside the app or extension to display file timestamps to the user. -->
                <!-- C617.1 — App's own functionality, not sent off-device. -->
                <string>C617.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
