# === LLM 1차 (vLLM, OpenAI 호환) ===
# 자체 vLLM 엔드포인트를 1차로 호출. 실패(네트워크/5xx/타임아웃/스키마 검증 실패)
# 시 OpenAI로 자동 fallback. LLM_PRIMARY_BASE_URL 미설정 시 OpenAI만 단독 호출.
LLM_PRIMARY_BASE_URL=http://3.38.195.121:5015/v1
LLM_PRIMARY_API_KEY=not-needed
# 빈값이면 첫 호출 시 GET /v1/models로 자동 디스커버리(첫 모델 사용)
LLM_PRIMARY_MODEL=
LLM_PRIMARY_TIMEOUT_MS=45000
LLM_PRIMARY_MAX_RETRIES=0

# === OpenAI (LLM fallback) ===
# 키는 .env.local 에만 저장하고 절대 커밋하지 말 것.
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=gpt-5.2-chat-latest
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=3
CLAUDE_API_KEY=replace-with-anthropic-api-key
GEMINI_API_KEY=replace-with-your-key

# === MariaDB (원격 211.188.53.253, SSH 터널 경유) ===
# 개발 시: `scripts/db-tunnel.sh` 실행해 로컬 3306으로 포워딩한 뒤 접속.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/database

# === Auth.js v5 (NextAuth) ===
# AUTH_SECRET: 세션 토큰 서명용. 유실 시 전 유저 세션 무효화 — 1Password 보관 필수.
# 재발급: `openssl rand -base64 32`
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Next.js 16 + Auth.js v5: 리버스 프록시 뒤에서 호스트 헤더 신뢰.
AUTH_TRUST_HOST=true

# === Google OAuth (console.cloud.google.com) ===
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

# === Kakao OAuth (developers.kakao.com) ===
# Redirect URI: http://localhost:3000/api/auth/callback/kakao
# AUTH_KAKAO_ID = REST API 키, AUTH_KAKAO_SECRET = Client Secret 코드.
AUTH_KAKAO_ID=replace-with-kakao-rest-api-key
AUTH_KAKAO_SECRET=replace-with-kakao-client-secret

# === Kokoro TTS 서버 (오픈모델, 추후 구현) ===
KOKORO_BASE_URL=http://localhost:8880

# === FLUX.1-schnell 서버 (Diffusers CPU, Linux) ===
FLUX_BASE_URL=http://localhost:8890

# === 이미지 생성 UI 노출 여부 (true일 때 표지/장면 그리기 버튼 표시) ===
NEXT_PUBLIC_ENABLE_IMAGE_GEN=false

# === 로컬 스토리지 디렉토리 (오디오·이미지 저장) ===
STORAGE_ROOT=./storage

# === 크레딧 패키지 가격 정책 (KRW 정수, 원 단위) ===
# 변경 후 pnpm build 재실행 필요 (NEXT_PUBLIC_*은 빌드 타임에 inline).
NEXT_PUBLIC_STAR_PACK_SMALL_PRICE_KRW=1900
NEXT_PUBLIC_STAR_PACK_MEDIUM_PRICE_KRW=9900
NEXT_PUBLIC_STAR_PACK_LARGE_PRICE_KRW=89000

# === 월간 동화 생성 한도 (가족 합산) ===
SUBSCRIPTION_MONTHLY_BOOK_LIMIT=50

# === 포트원 V2 (별 충전 결제) ===
# 콘솔: https://admin.portone.io  →  상점·결제 →  연동 정보
# - storeId / channelKey 는 NEXT_PUBLIC_* 으로 클라이언트 노출 OK (포트원 설계상 공개 키)
# - API_SECRET 은 서버 전용. 절대 클라이언트 번들에 포함 금지.
# - WEBHOOK_SECRET 은 향후 webhook 도입 시 추가.
NEXT_PUBLIC_PORTONE_STORE_ID=store-d57e6700-2418-4c4a-8bd1-85a7cb8a63dc
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=replace-with-channel-key
PORTONE_API_SECRET=replace-with-api-secret
# PORTONE_WEBHOOK_SECRET=replace-with-webhook-secret

# === 모바일 dev-issue (UI 자동화/QA용 access_token 발급) ===
# `POST /api/auth/mobile/dev-issue`가 아래 3개 모두 충족할 때만 토큰을 발급한다.
# 운영 기본값은 미설정 — 운영 사용 시 보안팀 승인 후 켜고 사용 종료 시 즉시 끌 것.
#   1) ALLOW_DEV_AUTH=1
#   2) DEV_AUTH_EMAILS: 발급 허용 이메일(콤마 구분, 소문자)
#   3) DEV_AUTH_SECRET: iOS Debug 빌드가 보내는 X-Dev-Auth-Secret 헤더 값.
#      생성: `openssl rand -base64 32` — iOS 시뮬레이터에는 env MOCK_AUTH_SECRET으로 주입.
# ALLOW_DEV_AUTH=
# DEV_AUTH_EMAILS=
# DEV_AUTH_SECRET=
