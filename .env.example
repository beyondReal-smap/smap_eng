# === OpenAI (LLM 전용) ===
# 키는 .env.local 에만 저장하고 절대 커밋하지 말 것
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=gpt-5.2-chat-latest
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=3
# OPENAI_BASE_URL=  # (선택) Azure/LiteLLM 등 OpenAI 호환 프록시

# === SQLite 경로 (기본: 프로젝트 루트 data.db) ===
DATABASE_PATH=./data.db

# === Kokoro TTS 서버 (오픈모델, 추후 구현) ===
KOKORO_BASE_URL=http://localhost:8880

# === FLUX.1-schnell 서버 (오픈모델, 추후 구현. ComfyUI API 예시) ===
FLUX_BASE_URL=http://localhost:8188

# === 로컬 스토리지 디렉토리 (오디오·이미지 저장) ===
STORAGE_ROOT=./storage
